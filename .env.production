# The production deployment serves the website and API from one address.
# Leave these unset for that setup.
#
# If you deploy the website and API separately, use origins only (no /api suffix):
# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws
#
# Reliable calls outside local networks need a TURN server:
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=turn-username
# VITE_TURN_CREDENTIAL=turn-password
