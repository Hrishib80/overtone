# Set ENVIRONMENT=production on the deployed service. Keep local development as development.
ENVIRONMENT=development

# Speech-to-text (worker only). Chosen for Telugu accuracy.
SARVAM_API_KEY=

# Real models are opt-in outside production, so a dev machine never downloads
# gigabytes by surprise. Set true once `pip install -r requirements-worker.txt`
# and `python scripts/fetch_models.py` have both been run.
USE_REAL_MODELS=false

# Database config
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/overtone

# Media Config. Supabase storage is required in production; this path is only a temporary upload location.
MEDIA_ROOT=media_uploads

# JWT Auth
JWT_SECRET_KEY=your_super_secret_jwt_key
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Supabase config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_BUCKET=profile-media

# CORS. Production must list the real website origin, without a trailing slash.
# Example: ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=*

# ---- Mail -------------------------------------------------------------------
# The campus gate rests on a verification link arriving. `console` logs the link
# and delivers nothing, which is why the app refuses to start in it when
# ENVIRONMENT=production.
MAIL_PROVIDER=console
MAIL_FROM=Overtone <no-reply@your-domain.edu>
# Where the verification link points. Not taken from the request Host header —
# that would let someone aim a link carrying a credential somewhere else.
PUBLIC_WEB_URL=http://localhost:5173

# SMTP rather than one vendor's HTTP API: it is the single interface SES,
# Postmark, Resend, Mailgun, Google Workspace and a university's own relay all
# speak, and on a campus the relay you end up allowed to use is rarely the one
# you planned for.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_TLS=false

# ---- Storage ----------------------------------------------------------------
# `local` writes into MEDIA_ROOT and needs no cloud account, so uploads work
# offline. Bytes pass through the API in that mode, which is why the app
# refuses to start on it when ENVIRONMENT=production.
STORAGE_PROVIDER=local

# For STORAGE_PROVIDER=supabase.
#
# SUPABASE_KEY must be the *server* key, not the browser one. Signing an upload
# is a server-side write and the browser key is subject to row-level security,
# which refuses it with a bare 400 and no explanation.
#
# Supabase renamed these, so the dashboard shows one of two sets under
# Project Settings -> API Keys:
#
#     new     "Secret keys"   ->  sb_secret_…            <- use this
#             "Publishable"   ->  sb_publishable_…
#     legacy  "service_role"  ->  a long JWT             <- or this
#             "anon"          ->  a long JWT
#
# Either server key works. Keep it server-side: it bypasses row-level security
# and must never be shipped to a browser.
#
# The bucket must already exist — Supabase does not create it on demand. Make
# it public, so profile photos can be served without a signed read.
#
# `python scripts/check_storage.py` reports which key is configured and
# whether the bucket is there.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_your_server_key
SUPABASE_BUCKET=uploads
