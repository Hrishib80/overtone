# Copy to .env for local development. Production values are set on the host
# (Render for the API, Vercel for the site) and never committed.

# ---- Environment -------------------------------------------------------------
# `production` refuses to start without every value it needs, a 32+ character
# JWT secret, explicit origins and Supabase storage.
ENVIRONMENT=development

# ---- Database ----------------------------------------------------------------
# Locally: SQLite. In production: Supabase Postgres, through the session pooler
# (port 5432). A password containing @ # / % must be percent-encoded.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Auth --------------------------------------------------------------------
# Production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=local-dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---- Web ---------------------------------------------------------------------
# The site's origin, without a trailing slash. A wildcard is refused in production.
ALLOWED_ORIGINS=*
# Where invite links point.
PUBLIC_WEB_URL=http://localhost:5173

# Whether a finished profile waits for an admin. Invite codes skip it either way.
REQUIRE_APPROVAL=true

# ---- Jobs and models ---------------------------------------------------------
# Real models are opt-in outside production, so a dev machine never downloads
# gigabytes by surprise. Set true once `pip install -r requirements-worker.txt`
# and `python scripts/fetch_models.py` have both been run.
USE_REAL_MODELS=false
# Run the job loop inside the API instead of `python worker.py`. Only with
# USE_REAL_MODELS=false; production refuses the combination otherwise.
RUN_WORKER_IN_API=false
# Speech-to-text for real models (worker only). Chosen for Telugu accuracy.
SARVAM_API_KEY=

# ---- Storage -----------------------------------------------------------------
# `local` writes into MEDIA_ROOT and needs no cloud account, so uploads work
# offline. Bytes pass through the API in that mode, which is why the app
# refuses to start on it when ENVIRONMENT=production.
STORAGE_PROVIDER=local
MEDIA_ROOT=media_uploads

# For STORAGE_PROVIDER=supabase.
#
# SUPABASE_KEY must be the *server* key, not the browser one. Signing an upload
# is a server-side write and the browser key is subject to row-level security,
# which refuses it with a bare 400 and no explanation.
#
# Supabase renamed these, so the dashboard shows one of two sets under
# Project Settings -> API Keys:
#
#     new     "Secret keys"   ->  sb_secret_…            <- use this
#             "Publishable"   ->  sb_publishable_…
#     legacy  "service_role"  ->  a long JWT             <- or this
#             "anon"          ->  a long JWT
#
# Either server key works. Keep it server-side: it bypasses row-level security
# and must never be shipped to a browser.
#
# The bucket must already exist — Supabase does not create it on demand. Make
# it public, so profile photos can be served without a signed read.
#
# `python scripts/check_storage.py` reports which key is configured and
# whether the bucket is there.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_your_server_key
SUPABASE_BUCKET=uploads

# ---- Chat fan-out --------------------------------------------------------------
# Unset means one process, which is right for a single instance.
REDIS_URL=

# ---- Logs ----------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=

# ---- Frontend (read by Vite at build time) -------------------------------------
# Where the API lives when the site is hosted separately. Empty means same origin.
VITE_API_URL=
# The admin portal's path. Change it whenever it has been shared too widely.
VITE_ADMIN_PATH=
